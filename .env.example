# ─────────────────────────────────────────────
# Amwag Attendance System — Environment Template
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to version control.
# ─────────────────────────────────────────────

# ──────────────────────────────────────────────
# Database (required)
# MySQL / MariaDB connection URL
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# ──────────────────────────────────────────────
DATABASE_URL=mysql://amwag:change-me@127.0.0.1:3306/amwag_attendance

# Public app origin used by middleware for internal auth lookups.
# Set this to your production domain, for example: https://attendance.example.com
APP_URL=http://localhost:3000

# ──────────────────────────────────────────────
# Internal Scheduler (required)
# Bearer token that protects /api/internal/* endpoints.
# Generate with: openssl rand -hex 32
# Use the same value in your server cron jobs.
# ──────────────────────────────────────────────
INTERNAL_SCHEDULER_SECRET=replace-with-64-char-random-hex

# Backup encryption (required in production)
# Generate a different 64-hex-character value with: openssl rand -hex 32
BACKUP_ENCRYPTION_KEY=replace-with-different-64-char-random-hex

# ──────────────────────────────────────────────
# Session (defaults shown; SESSION_TTL_DAYS is required in production)
# ──────────────────────────────────────────────
SESSION_COOKIE_NAME=amwag_session
SESSION_TTL_DAYS=30

# ──────────────────────────────────────────────
# Reverse Proxy (required in production: explicitly set "true" or "false")
# Set to "true" when running behind LiteSpeed / Nginx
# so the app reads real client IPs from X-Forwarded-For.
# Required for branch IP validation to work correctly in production.
# ──────────────────────────────────────────────
TRUST_X_FORWARDED_FOR=false

# ──────────────────────────────────────────────
# Node environment
# Set to "production" on the server.
# ──────────────────────────────────────────────
NODE_ENV=development
